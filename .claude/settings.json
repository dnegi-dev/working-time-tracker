{
  "autoCompactWindow": 200000,
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npx vitest *)",
      "Bash(npx playwright test *)",
      "Bash(npx prettier *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)"
    ],
    "deny": [
      "Read(./package-lock.json)",
      "Read(./dist/**)",
      "Read(./coverage/**)",
      "Read(./playwright-report/**)",
      "Read(./public/api/openapi.json)",
      "Read(./public/holidays/**)",
      "Read(./ios/App/build/**)",
      "Read(./ios/App/build-sim/**)",
      "Read(./ios/App/App/public/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/context-guard.mjs\" start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/context-guard.mjs\" prompt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/context-guard.mjs\" stop"
          }
        ]
      }
    ]
  }
}
