{
  "openapi": "3.1.0",
  "info": {
    "title": "Working Time – Command API",
    "version": "1",
    "description": "Every command is also a deep link. In the browser, calls are executed by the service worker in an open, logged-in app tab — open the app in another tab, then use \"Try it out\". Commands change state although they are GET, so they work as plain links (NFC, QR, Shortcuts)."
  },
  "servers": [
    {
      "url": "v1"
    }
  ],
  "paths": {
    "/clock-in": {
      "get": {
        "operationId": "clock-in",
        "summary": "Start working (no-op if already running)",
        "description": "Deep link: `wtt://clock-in?…` (iOS app) · `<app>#/do/clock-in?…` (web/PWA)",
        "parameters": [
          {
            "name": "project",
            "in": "query",
            "required": false,
            "description": "Project id or name",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "place",
            "in": "query",
            "required": false,
            "description": "Place (\"Building / Room\") id or name",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "description": "Used when no place is given",
            "schema": {
              "type": "string",
              "enum": [
                "office",
                "home"
              ]
            }
          },
          {
            "name": "source",
            "in": "query",
            "required": false,
            "description": "What triggered the call",
            "schema": {
              "type": "string",
              "enum": [
                "nfc",
                "qr",
                "geofence",
                "shortcut"
              ]
            }
          }
        ],
        "x-deeplink": {
          "native": "wtt://clock-in",
          "web": "#/do/clock-in"
        },
        "responses": {
          "200": {
            "description": "Done",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown project/place",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "No app tab open to execute the call",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/clock-out": {
