      }
    },
    "/switch-project": {
      "get": {
        "operationId": "switch-project",
        "summary": "Continue working on another project",
        "description": "Deep link: `wtt://switch-project?…` (iOS app) · `<app>#/do/switch-project?…` (web/PWA)",
        "parameters": [
          {
            "name": "project",
            "in": "query",
            "required": true,
            "description": "Project id or name",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "x-deeplink": {
