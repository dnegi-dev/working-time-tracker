      }
    },
    "/switch-place": {
      "get": {
        "operationId": "switch-place",
        "summary": "Change building/room (office or home follows the place)",
        "description": "Deep link: `wtt://switch-place?…` (iOS app) · `<app>#/do/switch-place?…` (web/PWA)",
        "parameters": [
          {
            "name": "place",
            "in": "query",
            "required": true,
            "description": "Place id or \"Building / Room\"",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "x-deeplink": {
          "native": "wtt://switch-place",
          "web": "#/do/switch-place"
        },
        "responses": {
          "200": {
            "description": "Done",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown project/place",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "No app tab open to execute the call",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/add-note": {
      "get": {
        "operationId": "add-note",
        "summary": "Add a note to a day, or to a project if given",
        "description": "Deep link: `wtt://add-note?…` (iOS app) · `<app>#/do/add-note?…` (web/PWA)",
        "parameters": [
          {
            "name": "text",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "project",
            "in": "query",
            "required": false,
            "description": "Project id or name",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "Defaults to today",
            "schema": {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            }
          }
        ],
        "x-deeplink": {
          "native": "wtt://add-note",
          "web": "#/do/add-note"
        },
        "responses": {
          "200": {
            "description": "Done",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown project/place",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "No app tab open to execute the call",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/mark-day": {
      "get": {
        "operationId": "mark-day",
        "summary": "Mark a day as vacation, sick or holiday (none removes the mark)",
        "description": "Deep link: `wtt://mark-day?…` (iOS app) · `<app>#/do/mark-day?…` (web/PWA)",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "vacation",
                "sick",
                "holiday",
                "none"
              ]
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "Defaults to today",
            "schema": {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            }
          }
        ],
        "x-deeplink": {
          "native": "wtt://mark-day",
          "web": "#/do/mark-day"
        },
        "responses": {
          "200": {
            "description": "Done",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown project/place",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "No app tab open to execute the call",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/status": {
      "get": {
        "operationId": "status",
        "summary": "Current state and today’s hours (read-only)",
        "description": "Deep link: `wtt://status?…` (iOS app) · `<app>#/do/status?…` (web/PWA)",
        "parameters": [],
        "x-deeplink": {
          "native": "wtt://status",
          "web": "#/do/status"
        },
        "responses": {
          "200": {
            "description": "Done",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown project/place",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "No app tab open to execute the call",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Result": {
        "type": "object",
        "properties": {
          "ok": {
            "const": true
          },
          "data": {
            "type": "object",
            "properties": {
              "running": {
                "type": "boolean"
              },
              "since": {
                "type": "string",
                "format": "date-time"
              },
              "project": {
                "type": "string"
              },
              "place": {
                "type": "string"
              },
              "mode": {
                "enum": [
                  "office",
                  "home"
                ]
              },
              "todayMinutes": {
                "type": "integer"
              },
              "remainingTodayMinutes": {
                "type": "integer"
              },
              "ignored": {
                "type": "string",
                "description": "Set when a duplicate trigger was ignored"
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "ok": {
            "const": false
          },
          "status": {
            "type": "integer"
          },
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
