{
  "name": "working-time-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run gen:openapi && vite build",
    "preview": "vite preview",
    "gen:openapi": "node --experimental-strip-types scripts/gen-openapi.ts",
    "gen:holidays": "node --experimental-strip-types scripts/fetch-holidays.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "svelte-check --fail-on-warnings",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run arch && npm run i18n && npm run test:cov && npm run openapi:check",
    "openapi:check": "npm run gen:openapi && git diff --exit-code public/api/openapi.json",
    "i18n": "node --experimental-strip-types scripts/check-i18n.ts",
    "build:ios": "BASE_PATH=./ npm run build && npx cap sync ios",
    "gen:icons": "node --experimental-strip-types scripts/gen-icons.ts"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^5.0.2",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^10.11.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "read-excel-file": "^9.3.10",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "workbox-build": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "qrcode": "^1.5.4",
    "swagger-ui-dist": "^5.33.0",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.5"
  }
}
